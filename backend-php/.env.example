APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

# Configuración MySQL
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=nombre_base_datos
DB_MYSQL_USERNAME=usuario_mysql
DB_MYSQL_PASSWORD="tu_password_aqui"

# JWT
JWT_SECRET=cambiar-por-secreto-seguro-en-produccion
JWT_TTL_SECONDS=86400

# Usuario Administrador Inicial (Opcional para primer arranque)
ADMIN_INITIAL_PASSWORD=cambiar-por-password-seguro

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000

